APP_NAME=AI Career Companion API
APP_ENV=development
DEBUG=false
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:///./data/ai_career_companion.db
RESUME_STORAGE_DIR=./data/resumes
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Milestone 3.2 LLM rewrite layer — optional. Leave LLM_PROVIDER=none (the default)
# to keep the deterministic-only pipeline. Set to "openai_compatible" plus the
# fields below to enable LLM-assisted rewriting against any OpenAI chat-completions-
# compatible endpoint (OpenAI itself, a local Ollama/vLLM server, etc.). Never commit
# a real LLM_API_KEY.
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20