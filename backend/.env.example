APP_NAME=AI Career Companion API
APP_ENV=development
DEBUG=false
FRONTEND_URL=http://localhost:5173
DATABASE_URL=sqlite:///./data/ai_career_companion.db
RESUME_STORAGE_DIR=./data/resumes
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Milestone 3.2 LLM rewrite layer — optional. Leave LLM_PROVIDER=none (the default)
# to keep the deterministic-only pipeline. Set to "openai_compatible" plus the
# fields below to enable LLM-assisted rewriting against any OpenAI chat-completions-
# compatible endpoint. Never commit a real LLM_API_KEY — this file holds
# placeholders only; put the real value in your local, gitignored backend/.env.
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20

# Example: OpenAI itself
#   LLM_PROVIDER=openai_compatible
#   LLM_MODEL=<model-name>
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=your_api_key_here
#   LLM_TIMEOUT_SECONDS=20
#
# Example: Google Gemini via its OpenAI-compatible endpoint
#   LLM_PROVIDER=openai_compatible
#   LLM_MODEL=<model-name>
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=your_api_key_here
#   LLM_TIMEOUT_SECONDS=60